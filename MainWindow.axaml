<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Voip.MainWindow"
        Title="Voip">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Direct P2P Mesh Voice Call" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <TextBox Grid.Column="0" x:Name="PeerIpTextBox" Watermark="Enter Target Peer IP (e.g., 10.0.0.5)" Margin="0,0,10,0"/>
            <Button Grid.Column="1" x:Name="CallButton" Content="Call Peer" Click="CallPeerButton_Click" Padding="15,8"/>
        </Grid>

        <Border Grid.Row="2" CornerRadius="5" Background="#1E1E1E" Padding="10">
            <ScrollViewer x:Name="LogScrollViewer">
                <SelectableTextBlock x:Name="LogTextBlock" Foreground="#00FF66" FontFamily="Consolas, Monospace" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Text="Status: Idle" Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
